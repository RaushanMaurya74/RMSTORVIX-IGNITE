# RMSTORVIX IGNITE — Environment Configuration Template
# Do not commit production credentials to version control.

APP_NAME="RMSTORVIX IGNITE"
APP_ENV=production
APP_PORT=8080
APP_URL=http://127.0.0.1:8080

# Database Driver Selection: sqlite (default embedded) or mysql (cloud/server)
DB_CONNECTION=sqlite
DB_PATH=database/rmstorvix_ignite.sqlite

# MySQL / MariaDB Production Deployment (When DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rmstorvix_ignite
DB_USERNAME=rmstorvix_user
DB_PASSWORD=your_secure_database_password_here

# Security & Session Settings
SESSION_SECRET=replace_with_64_character_random_hex_string
SESSION_SECURE_COOKIE=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Indian GST & Financial Year Defaults
DEFAULT_STATE_CODE=27
DEFAULT_CURRENCY=INR
FINANCIAL_YEAR_START_MONTH=4
